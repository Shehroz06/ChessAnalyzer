# Path to the Stockfish binary
# Linux:   /usr/games/stockfish  or  /usr/bin/stockfish
# macOS:   /opt/homebrew/bin/stockfish   (after: brew install stockfish)
# Windows: C:\stockfish\stockfish.exe
STOCKFISH_PATH=stockfish

PORT=8000

# ── AI commentary ────────────────────────────────────────────────────────────
# Primary provider: Google Gemini. Get a key at https://aistudio.google.com/apikey
# If GEMINI_ENABLED is false, the key is empty, or a request errors/hits the
# rate limit below, /api/commentary automatically falls back to a local Ollama
# model (see README → AI Commentary). If neither is available, the frontend
# falls back to built-in template commentary.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_ENABLED=true
GEMINI_MAX_RPM=15
